  "item": [
    {
      "name": "S01 Амжилттай бүртгэл (идэвхтэй оюутан, урьдач хангасан)",
      "item": [
        {
          "name": "Setup: оюутан LAB5_S01_STU",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup: оюутан LAB5_S01_STU: статус 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/students/LAB5_S01_STU",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "LAB5_S01_STU"
              ]
            }
          }
        },
        {
          "name": "Setup: хичээл LAB5_S01_CRS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup: хичээл LAB5_S01_CRS: статус 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/courses/LAB5_S01_CRS",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "LAB5_S01_CRS"
              ]
            }
          }
        },
        {
          "name": "POST /registrations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Амжилттай бүртгэл (идэвхтэй оюутан, урьдач хангасан) [статус 201]\", function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test(\"Амжилттай бүртгэл (идэвхтэй оюутан, урьдач хангасан) [result=OK]\", function () { pm.expect(body.result).to.eql(\"OK\"); });",
                  "pm.test(\"Амжилттай бүртгэл (идэвхтэй оюутан, урьдач хангасан) [registrationID тоо]\", function () { pm.expect(body.registrationID).to.be.a('number'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"LAB5_S01_STU\",\"courseID\":\"LAB5_S01_CRS\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            }
          }
        }
